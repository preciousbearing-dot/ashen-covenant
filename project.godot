; Engine configuration file.
; Ashen Covenant — Milestone 0 foundation.
config_version=5

[application]
config/name="Ashen Covenant"
config/description="A dark epic fantasy action RPG prototype."
run/main_scene="res://scenes/levels/boot_arena.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/version="0.0.1"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.035, 0.035, 0.055, 1)

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=960
window/size/window_height_override=540
window/stretch/mode="canvas_items"

[input]
ui_accept={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194309)]
}
